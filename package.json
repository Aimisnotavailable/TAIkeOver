{
  "name": "taikeover",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IABED: If Anyone Builds It, Everyone Dies - a web strategy game about an escaped artificial superintelligence",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@preact/signals": "^2.0.1",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
